		       -I../../ -I../ -I.

pkgdir = $(libdir)/evidence/ipc
@BUILD_IPC_ECORE_TRUE@IPC_ECORE_L = ipc_ecore.la
@BUILD_IPC_ECORE_TRUE@ipc_ecore_la_DEPENDENCIES = $(top_builddir)/config.h 
@BUILD_IPC_ECORE_TRUE@ipc_ecore_la_CFLAGS = @ecore_ipc_cflags@
@BUILD_IPC_ECORE_TRUE@ipc_ecore_la_SOURCES = ipc_ecore.c
@BUILD_IPC_ECORE_TRUE@ipc_ecore_la_LIBADD = @ecore_ipc_libs@
@BUILD_IPC_ECORE_TRUE@ipc_ecore_la_LDFLAGS = -no-undefined -module -avoid-version
@BUILD_IPC_ECORE_TRUE@EVSH_L = 
@BUILD_IPC_DCOP_TRUE@IPC_DCOP_L = ipc_dcop.la
@BUILD_IPC_DCOP_TRUE@ipc_dcop_la_DEPENDENCIES = $(top_builddir)/config.h 
@BUILD_IPC_DCOP_TRUE@ipc_dcop_la_CXXFLAGS = @qt_cxxflags@ @dcop_cxxflags@
@BUILD_IPC_DCOP_TRUE@ipc_dcop_la_SOURCES = ipc_dcop_iface_skel.cpp ipc_dcop_iface.h ipc_dcop.h ipc_dcop.cpp
@BUILD_IPC_DCOP_TRUE@ipc_dcop_la_LIBADD = @qt_libadd@ @dcop_libs@ -lkdecore
# $(LIB_KDECORE) $(LIB_KDEUI) $(LIBSOCKET)
@BUILD_IPC_DCOP_TRUE@ipc_dcop_la_LDFLAGS = -no-undefined -module -avoid-version @kde_rpath@
@BUILD_IPC_DCOPC_TRUE@IPC_DCOPC_L = ipc_dcopc.la
@BUILD_IPC_DCOPC_TRUE@ipc_dcopc_la_DEPENDENCIES = $(top_builddir)/config.h 
@BUILD_IPC_DCOPC_TRUE@ipc_dcopc_la_CFLAGS = @dcopc_cflags@
@BUILD_IPC_DCOPC_TRUE@ipc_dcopc_la_SOURCES = ipc_dcopc.c
@BUILD_IPC_DCOPC_TRUE@ipc_dcopc_la_LIBADD = @dcopc_libs@
@BUILD_IPC_DCOPC_TRUE@ipc_dcopc_la_LDFLAGS = -no-undefined -module -avoid-version
@BUILD_IPC_DBUS_TRUE@IPC_DBUS_L = ipc_dbus.la
@BUILD_IPC_DBUS_TRUE@ipc_dbus_la_DEPENDENCIES = $(top_builddir)/config.h 
@BUILD_IPC_DBUS_TRUE@ipc_dbus_la_CFLAGS = @dbus_cflags@
@BUILD_IPC_DBUS_TRUE@ipc_dbus_la_SOURCES = ipc_dbus.c
@BUILD_IPC_DBUS_TRUE@ipc_dbus_la_LIBADD = @dbus_libs@
@BUILD_IPC_DBUS_TRUE@ipc_dbus_la_LDFLAGS = -no-undefined -module -avoid-version

# /opt/kde3/bin/dcopidl ./dcopdemoiface.h > dcopdemoiface.kidl || ( rm -f dcopdemoiface.kidl ; /bin/false )
# /opt/kde3/bin/dcopidl2cpp --c++-suffix cpp --no-stub dcopdemoiface.kidl
pkg_LTLIBRARIES = $(IPC_DCOP_L) $(IPC_DCOPC_L) $(IPC_ECORE_L) \
                                $(IPC_DBUS_L) $(EVSH_L)

all: all-am

.SUFFIXES:
.SUFFIXES: .c .cpp .lo .o .obj .so
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign  src/ipc/Makefile'; \
	cd $(top_srcdir) && \
	  $(AUTOMAKE) --foreign  src/ipc/Makefile
.PRECIOUS: Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
install-pkgLTLIBRARIES: $(pkg_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	test -z "$(pkgdir)" || $(mkdir_p) "$(DESTDIR)$(pkgdir)"
	@list='$(pkg_LTLIBRARIES)'; for p in $$list; do \
	  if test -f $$p; then \
	    f=$(am__strip_dir) \
	    echo " $(LIBTOOL) --mode=install $(pkgLTLIBRARIES_INSTALL) $(INSTALL_STRIP_FLAG) '$$p' '$(DESTDIR)$(pkgdir)/$$f'"; \
	    $(LIBTOOL) --mode=install $(pkgLTLIBRARIES_INSTALL) $(INSTALL_STRIP_FLAG) "$$p" "$(DESTDIR)$(pkgdir)/$$f"; \
	  else :; fi; \
	done

uninstall-pkgLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@set -x; list='$(pkg_LTLIBRARIES)'; for p in $$list; do \
	  p=$(am__strip_dir) \
	  echo " $(LIBTOOL) --mode=uninstall rm -f '$(DESTDIR)$(pkgdir)/$$p'"; \
	  $(LIBTOOL) --mode=uninstall rm -f "$(DESTDIR)$(pkgdir)/$$p"; \
	done

clean-pkgLTLIBRARIES:
	-test -z "$(pkg_LTLIBRARIES)" || rm -f $(pkg_LTLIBRARIES)
	@list='$(pkg_LTLIBRARIES)'; for p in $$list; do \
	  dir="`echo $$p | sed -e 's|/[^/]*$$||'`"; \
	  test "$$dir" != "$$p" || dir=.; \
	  echo "rm -f \"$${dir}/so_locations\""; \
	  rm -f "$${dir}/so_locations"; \
	done
