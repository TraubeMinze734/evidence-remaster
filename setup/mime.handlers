# default-handlers: if a data-file is double-clicked, what do we open it with?
# started by Azundris, massively extended by Pokey Templar
#
# Examples:
#
#   text/plain $EDITOR
# 	Any plain text file you double click will be opened with $EDITOR
#
#   text/* kate
# 	Any text MIME-type file will be opened by kate
#
#   * xemacs
#       Any file is opened with xemacs
#
# This is a (somewhat) complete listing of IAVA MIME Types and 
# SuSE 9.1 MIME types.

TEXT=gnuclient
AUDIO=eplay
# AUDIO=xmms -e %s
GIMP=gimp-remote
IMAGE=entice
# IMAGE=xv
# IMAGE=eog
VIDEO=mplayer
WP=soffice
# WP=swriter
BROWSER=opera
FALLBACK=gnuclient
COMICS=qcomicbook



### x-azundris-extra : )
application/x-comic-rar			$COMICS
application/x-comic-zip			$COMICS

application/x-c-source			$TEXT
application/x-c-header			$TEXT

application/x-torrent			btdownloadgui.py



