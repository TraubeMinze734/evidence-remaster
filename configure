ac_subst_vars='SHELL PATH_SEPARATOR PACKAGE_NAME PACKAGE_TARNAME PACKAGE_VERSION PACKAGE_STRING PACKAGE_BUGREPORT exec_prefix prefix program_transform_name bindir sbindir libexecdir datadir sysconfdir sharedstatedir localstatedir libdir includedir oldincludedir infodir mandir build_alias host_alias target_alias DEFS ECHO_C ECHO_N ECHO_T LIBS build build_cpu build_vendor build_os host host_cpu host_vendor host_os target target_cpu target_vendor target_os INSTALL_PROGRAM INSTALL_SCRIPT INSTALL_DATA CYGPATH_W PACKAGE VERSION ACLOCAL AUTOCONF AUTOMAKE AUTOHEADER MAKEINFO install_sh STRIP ac_ct_STRIP INSTALL_STRIP_PROGRAM mkdir_p AWK SET_MAKE am__leading_dot AMTAR am__tar am__untar CC CFLAGS LDFLAGS CPPFLAGS ac_ct_CC EXEEXT OBJEXT DEPDIR am__include am__quote AMDEP_TRUE AMDEP_FALSE AMDEPBACKSLASH CCDEPMODE am__fastdepCC_TRUE am__fastdepCC_FALSE CPP EGREP CXX CXXFLAGS ac_ct_CXX CXXDEPMODE am__fastdepCXX_TRUE am__fastdepCXX_FALSE LN_S ECHO AR ac_ct_AR RANLIB ac_ct_RANLIB CXXCPP F77 FFLAGS ac_ct_F77 LIBTOOL DLLDFLAGS LIBOBJS PTHREAD_CC PTHREAD_LIBS PTHREAD_CFLAGS PKG_CONFIG ac_pt_PKG_CONFIG GTK_CFLAGS GTK_LIBS GLIB_CFLAGS GLIB_LIBS VALGRIND_CFLAGS VALGRIND_LIBS btrace_cflags btrace_libs doodle_cflags doodle_libs qt_dir qt_cxxflags qt_libadd MOC kde_config kde_dir kde_cxxflags kde_libadd kde_rpath DCOPIDL DCOPIDL2CPP moc dcopidl DBUS_CFLAGS DBUS_LIBS dbus_cflags dbus_libs dcop_cxxflags dcop_libs ECORE_CONFIG ECORE_CFLAGS ECORE_LIBS ecore_libs ecore_cflags ecore_ipc_libs ecore_ipc_cflags EVAS_CONFIG EVAS_CFLAGS EVAS_LIBS evas_libs evas_cflags EDB_CONFIG EDB_CFLAGS EDB_LIBS edb_libs edb_cflags EET_CONFIG EET_CFLAGS EET_LIBS eet_libs eet_cflags EDJE_CONFIG EDJE_CFLAGS EDJE_LIBS edje_libs edje_cflags EVIDENCE_CFLAGS EVIDENCE_LIBS gnomecanvas_libs gnomecanvas_cflags IMLIB2_CONFIG IMLIB2_CFLAGS IMLIB2_LIBS imlib2_libs imlib2_cflags LIBPNG_CONFIG PNG_CFLAGS PNG_LIBS LIBPNG_CFLAGS LIBPNG_LIBS libpng_cflags libpng_libs libjpeg_cflags libjpeg_libs iconv_cflags iconv_libs libreadline_cflags libreadline_libs PCRE_CONFIG PCRE_CFLAGS PCRE_LIBS pcre_libs pcre_cflags BACKEND_GNOMEVFS2_CFLAGS BACKEND_GNOMEVFS2_LIBS efsd_libs efsd_cflags CURL_CONFIG CURL_CFLAGS CURL_LIBS curl_cflags curl_libs attr_libs attr_cflags acl_libs acl_cflags libmagic_libs libmagic_cflags libsharedmime_CFLAGS libsharedmime_LIBS fam_cflags fam_libs extractor_libs extractor_cflags TAGLIB_CONFIG TAGLIB_CFLAGS TAGLIB_LIBS vorbis_libs vorbis_cflags id3_libs id3_cflags XINE_CONFIG XINE_CFLAGS XINE_LIBS xine_LIBS xine_CFLAGS xine_PLUGINS avi_CFLAGS avi_LIBS mpeg3_libs mpeg3_cflags FREETYPE_CONFIG FREETYPE_CFLAGS FREETYPE_LIBS ttf_libs ttf_cflags BUILD_ECORE_MAINLOOP_TRUE BUILD_ECORE_MAINLOOP_FALSE BUILD_ECORE_DEPENDENT_TRUE BUILD_ECORE_DEPENDENT_FALSE BUILD_WITH_GNOMECANVAS_TRUE BUILD_WITH_GNOMECANVAS_FALSE BUILD_WITH_EVAS2_TRUE BUILD_WITH_EVAS2_FALSE BUILD_WITH_ICONLIST_TRUE BUILD_WITH_ICONLIST_FALSE BUILD_WITH_EDB_TRUE BUILD_WITH_EDB_FALSE BUILD_WITH_EET_TRUE BUILD_WITH_EET_FALSE BUILD_WITH_EDJE_TRUE BUILD_WITH_EDJE_FALSE BUILD_WITH_X_TRUE BUILD_WITH_X_FALSE BUILD_PLUGIN_IMAGE_TRUE BUILD_PLUGIN_IMAGE_FALSE BUILD_PLUGIN_TAGLIB_TRUE BUILD_PLUGIN_TAGLIB_FALSE BUILD_PLUGIN_LIBVORBIS_TRUE BUILD_PLUGIN_LIBVORBIS_FALSE BUILD_PLUGIN_MP3_TRUE BUILD_PLUGIN_MP3_FALSE BUILD_PLUGIN_TTF_TRUE BUILD_PLUGIN_TTF_FALSE BUILD_PLUGIN_EXTRACTOR_TRUE BUILD_PLUGIN_EXTRACTOR_FALSE BUILD_BACKEND_POSIX_TRUE BUILD_BACKEND_POSIX_FALSE BUILD_BACKEND_GNOMEVFS2_TRUE BUILD_BACKEND_GNOMEVFS2_FALSE BUILD_BACKEND_KIO_TRUE BUILD_BACKEND_KIO_FALSE BUILD_BACKEND_EFSD_TRUE BUILD_BACKEND_EFSD_FALSE BUILD_THUMBNAILER_IMLIB2_TRUE BUILD_THUMBNAILER_IMLIB2_FALSE BUILD_THUMBNAILER_EPEG_TRUE BUILD_THUMBNAILER_EPEG_FALSE BUILD_THUMBNAILER_AVIFILE_TRUE BUILD_THUMBNAILER_AVIFILE_FALSE BUILD_THUMBNAILER_MPEG3_TRUE BUILD_THUMBNAILER_MPEG3_FALSE BUILD_THUMBNAILER_XINE_TRUE BUILD_THUMBNAILER_XINE_FALSE BUILD_THUMBNAILER_ID3_TRUE BUILD_THUMBNAILER_ID3_FALSE BUILD_IPC_ECORE_TRUE BUILD_IPC_ECORE_FALSE BUILD_IPC_DCOP_TRUE BUILD_IPC_DCOP_FAL