  echo $ECHO_N "(cached) $ECHO_C" >&6
else
  case $TAGLIB_CONFIG in
  [\\/]* | ?:[\\/]*)
  ac_cv_path_TAGLIB_CONFIG="$TAGLIB_CONFIG" # Let the user override the test with a path.
  ;;
  *)
  as_save_IFS=$IFS; IFS=$PATH_SEPARATOR
for as_dir in $PATH
do
  IFS=$as_save_IFS
  test -z "$as_dir" && as_dir=.
  for ac_exec_ext in '' $ac_executable_extensions; do
  if $as_executable_p "$as_dir/$ac_word$ac_exec_ext"; then
    ac_cv_path_TAGLIB_CONFIG="$as_dir/$ac_word$ac_exec_ext"
    echo "$as_me:$LINENO: found $as_dir/$ac_word$ac_exec_ext" >&5
    break 2
  fi
done
done

  test -z "$ac_cv_path_TAGLIB_CONFIG" && ac_cv_path_TAGLIB_CONFIG="no"
  ;;
esac
fi
TAGLIB_CONFIG=$ac_cv_path_TAGLIB_CONFIG

if test -n "$TAGLIB_CONFIG"; then
  echo "$as_me:$LINENO: result: $TAGLIB_CONFIG" >&5
echo "${ECHO_T}$TAGLIB_CONFIG" >&6
else
  echo "$as_me:$LINENO: result: no" >&5
echo "${ECHO_T}no" >&6
fi

  echo "$as_me:$LINENO: checking for taglib - version >= 1.3" >&5
echo $ECHO_N "checking for taglib - version >= 1.3... $ECHO_C" >&6

  no_taglib=""
  if test "$TAGLIB_CONFIG" = "no" ; then
     no_taglib=yes
  else
     TAGLIB_CFLAGS="`$TAGLIB_CONFIG $taglib_config_args --cflags`"
     TAGLIB_LIBS="`$TAGLIB_CONFIG $taglib_config_args --libs`"

        taglib_config_major_version=`$TAGLIB_CONFIG $taglib_config_args \
         --version | sed 's/[^0-9]*\([0-9]*\).\([0-9]*\).\([0-9]*\)/\1/'`
        taglib_config_minor_version=`$TAGLIB_CONFIG $taglib_config_args \
         --version | sed 's/[^0-9]*\([0-9]*\).\([0-9]*\).\([0-9]*\)/\2/'`
        taglib_config_micro_version=`$TAGLIB_CONFIG $taglib_config_args \
         --version | sed 's/[^0-9]*\([0-9]*\).\([0-9]*\).\([0-9]*\)/\3/'`
        taglib_wanted_major_version="1"
        taglib_wanted_minor_version="3"
        taglib_wanted_micro_version=""

        # Compare wanted version to what config script returned.
        # If I knew what library was being run, i'd probably also compile
        # a test program at this point (which also extracted and tested
        # the version in some library-specific way)
        if test "$taglib_config_major_version" -lt \
                        "$taglib_wanted_major_version" \
          -o \( "$taglib_config_major_version" -eq \
                        "$taglib_wanted_major_version" \
            -a "$taglib_config_minor_version" -lt \
                        "$taglib_wanted_minor_version" \) \
          -o \( "$taglib_config_major_version" -eq \
                        "$taglib_wanted_major_version" \
            -a "$taglib_config_minor_version" -eq \
                        "$taglib_wanted_minor_version" \
            -a "$taglib_config_micro_version" -lt \
                        "$taglib_wanted_micro_version" \) ; then
          # older version found
          no_taglib=yes
          echo -n "*** An old version of taglib "
          echo -n "($taglib_config_major_version"
          echo -n ".$taglib_config_minor_version"
          echo    ".$taglib_config_micro_version) was found."
          echo -n "*** You need a version of taglib newer than "
          echo -n "$taglib_wanted_major_version"
          echo -n ".$taglib_wanted_minor_version"
          echo    ".$taglib_wanted_micro_version."
          echo "***"
          echo "*** If you have already installed a sufficiently new version, this error"
          echo "*** probably means that the wrong copy of the taglib-config shell script is"
          echo "*** being found. The easiest way to fix this is to remove the old version"
          echo "*** of taglib, but you can also set the TAGLIB_CONFIG environment to point to the"
          echo "*** correct copy of taglib-config. (In this case, you will have to"
          echo "*** modify your LD_LIBRARY_PATH environment variable, or edit /etc/ld.so.conf"
          echo "*** so that the correct libraries are found at run-time)"
        fi

  fi
  if test "x$no_taglib" = x ; then
     echo "$as_me:$LINENO: result: yes" >&5
echo "${ECHO_T}yes" >&6
     TAGLIB_CFLAGS=`taglib-config --cflags`
                             TAGLIB_LIBS=`taglib-config --libs`
                             taglib=yes;
  else
     echo "$as_me:$LINENO: result: no" >&5
echo "${ECHO_T}no" >&6
     if test "$TAGLIB_CONFIG" = "no" ; then
       echo "*** The taglib-config script installed by taglib could not be found"
       echo "*** If taglib was installed in PREFIX, make sure PREFIX/bin is in"
       echo "*** your path, or set the TAGLIB_CONFIG environment variable to the"
       echo "*** full path to taglib-config."
     fi
     TAGLIB_CFLAGS=""
     TAGLIB_LIBS=""
     taglib=no;
  fi






fi;

        if test "$taglib" = "no"; then
          { echo "$as_me:$LINENO: WARNING: Could not find all headers and libraries for taglib." >&5
echo "$as_me: WARNING: Could not find all headers and libraries for taglib." >&2;}
        else

cat >>confdefs.h <<\_ACEOF
