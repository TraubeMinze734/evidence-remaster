AC_MSG_CHECKING(whether the tree-view is to be built)
AC_ARG_ENABLE(tree-view, AC_HELP_STRING([--enable-tree-view],[build with experimental tree-view]),
        [ ac_use_tree_view="$enableval" ],
        [ ac_use_tree_view="yes" ]
        )
if test X"$ac_use_tree_view" = Xyes; then
        AC_MSG_RESULT(yes -- good luck)
                AC_DEFINE(WITH_TREEVIEW, 1, build with tree-view)
                treeview=gtk2;
else
        AC_MSG_RESULT(no -- good call)
                treeview=none;
fi

AC_MSG_CHECKING(whether the icon-view is to be built)
AC_ARG_ENABLE(icon-view, AC_HELP_STRING([--enable-icon-view],[build with icon-view]),
        [ ac_use_icon_view="$enableval" ],
        [ ac_use_icon_view="yes" ]
        )
if test X"$ac_use_icon_view" = Xyes; then
        if test X"$iconview" = Xnone; then
          AC_MSG_RESULT(no -- no canvas)
        else
          AC_MSG_RESULT(yes)
          AC_DEFINE(WITH_ICONVIEW, 1, build with icon-view)
        fi
else
        AC_MSG_RESULT(no)
fi

AC_MSG_CHECKING(whether the browser-view is to be built)
AC_ARG_ENABLE(browserview-view, AC_HELP_STRING([--enable-browser-view],[build with browser-view]),
        [ ac_use_browserview_view="$enableval" ],
        [ ac_use_browserview_view="yes" ]
        )
if test X"$ac_use_browserview_view" = Xyes; then
        AC_MSG_RESULT(yes)
        AC_DEFINE(WITH_BROWSERVIEW, 1, build with browser-view)
        browserview=gtk2;
else
        AC_MSG_RESULT(no)
        browserview=none;
fi






