dnl Process this file with autoconf to produce a configure script.

rm -f config.cache

# AC_INIT(acinclude.m4)
AC_INIT(configure.in)

AC_DEFINE_UNQUOTED([CONFIGURED_WITH], "$*", [what options were given to configure])

AC_CANONICAL_BUILD
AC_CANONICAL_HOST
AC_CANONICAL_TARGET

# AC_INIT_PACKAGE(evidence, 0.9.8, evidence@azundris.com)
AM_INIT_AUTOMAKE(evidence, 0.9.8)
AC_CONFIG_HEADER(config.h)

AC_PREREQ(2.52)

AC_ISC_POSIX
AC_PROG_CC
AM_PROG_CC_STDC
AC_HEADER_STDC
AC_PROG_INSTALL
AC_PROG_CXX
AC_LANG(C)


AM_ENABLE_SHARED
dnl AM_DISABLE_STATIC
AC_LIBTOOL_DLOPEN
AM_PROG_LIBTOOL
# AM_WITH_DMALLOC

if test X"$enable_shared" = Xyes; then
 DLLDFLAGS=-export-dynamic
 AC_SUBST(DLLDFLAGS)
fi






dnl ###########################################################################
dnl # functions
dnl ###################

AC_C_CONST
AC_C_INLINE
AC_C_VOLATILE
AC_C_BIGENDIAN

AC_STRUCT_TM
AC_STRUCT_ST_BLKSIZE
AC_STRUCT_ST_BLOCKS

AC_TYPE_PID_T
AC_TYPE_SIZE_T
AC_TYPE_UID_T
AC_TYPE_SIGNAL
AC_TYPE_OFF_T
AC_TYPE_MODE_T

AC_CHECK_TYPE(ulong, ,[AC_DEFINE(ulong, u_long,[FreeBSD compat])])

AC_CHECK_HEADERS([limits.h])

AC_HEADER_TIME

AC_CHECK_FUNCS([localtime_r])
AC_CHECK_FUNCS([nl_langinfo])
AC_CHECK_FUNCS([memset])
AC_CHECK_FUNCS([memmove])
AC_CHECK_FUNCS([strcasecmp])
AC_CHECK_FUNCS([strncasecmp])
AC_CHECK_FUNCS([strtol])
AC_CHECK_FUNCS([strstr])
AC_CHECK_FUNCS([strrchr])
AC_CHECK_FUNCS([strchr])
AC_CHECK_FUNCS([strdup])
AC_CHECK_FUNCS([select])

AC_CHECK_FUNCS([ftello])
AC_CHECK_FUNCS([fseeko])
AC_CHECK_FUNCS([strtoul])
AC_CHECK_FUNCS([strtoull])

AC_CHECK_FUNCS([statfs])
AC_CHECK_FUNCS([statvfs])

AC_SYS_LARGEFILE
# AC_SYS_LONG_FILE_NAMES

AC_FUNC_SELECT_ARGTYPES
AC_FUNC_STAT
AC_FUNC_MALLOC
AC_FUNC_FORK
AC_FUNC_MKTIME
AC_FUNC_LSTAT
AC_FUNC_CLOSEDIR_VOID

ACX_PTHREAD()

# inspired by Bruno Haible
langinfo=no
AC_TRY_LINK([#include <langinfo.h>],
      [char *cs=nl_langinfo(CODESET);],
      [AC_DEFINE(HAVE_LANGINFO_CODESET,1,[Have <langinfo.h> and nl_langinfo(CODESET).])
      langinfo=yes])






dnl ###########################################################################
dnl # pkg-config / GTK2
dnl ###################

AC_PATH_PROG(PKG_CONFIG, pkg-config, no)
if test x$PKG_CONFIG = xno ; then
   AC_MSG_ERROR([*** pkg-config not found. See
   http://pkgconfig.sourceforge.net])
fi

if ! pkg-config --atleast-pkgconfig-version 0.5 ; then
   AC_MSG_ERROR([*** pkg-config too old; version 0.5 or better required.])
fi

dnl If you compile against GTK2.0.x, some of the selection stuff migh
dnl act up -- the functions are present in GTK2.0.x, but they don't do
dnl anything yet... : (

# PKG_CHECK_MODULES(GTHREAD, gthread-2.0 >= 2.0, [AC_DEFINE(HAVE_GTHREAD, 1, use GThread)])
# AC_SUBST(GTHREAD_CFLAGS)
# AC_SUBST(GTHREAD_LIBS)

PKG_CHECK_MODULES(GTK, gtk+-2.0 >= 2.0, [AC_DEFINE(HAVE_GTK2, 1, use GTK2 GUI toolkit)])
# GTK_CFLAGS="$GTK_CFLAGS $GTHREAD_CFLAGS"
# GTK_LIBS="$GTK_LIB $GTHREAD_LIBS"
AC_SUBST(GTK_CFLAGS)
AC_SUBST(GTK_LIBS)






dnl ###########################################################################
dnl # checking for utils
dnl ###################

hashes="none";
AC_MSG_CHECKING(whether to use glib)
AC_ARG_ENABLE(glib, AC_HELP_STRING([--enable-glib],[use glib]),
                [ ac_use_glib="$enableval" ],
                [ ac_use_glib="yes" ]
                )
if test X"$ac_use_glib" = Xyes; then
        AC_MSG_RESULT(yes)
        PKG_CHECK_MODULES(GLIB, glib-2.0 >= 2.0 )
        AC_DEFINE(HAVE_GLIB2, 1, use glib2 mainloop)
        hashes="glib";
        glib="yes";
        loop="glib"
else
        AC_MSG_RESULT(no)
fi

#AC_MSG_CHECKING(whether to use judy)
#AC_ARG_ENABLE(judy, AC_HELP_STRING([--disable-judy],[do not use judy hashes]),[
#               AC_MSG_RESULT(no)
#               ], [
#               AC_MSG_RESULT(yes)
#               AC_ARG_WITH(attr,
#                  AC_HELP_STRING([--with-judy=DIR],[use Judy hashes in <DIR>]),
#                  [judy_cflags="-I$withval/include"
#                  judy_libs="-L$withval/lib -lJudy"
#                  hashes="judy";
#                  AC_DEFINE(HAVE_JUDY, 1, use Judy hashes)],
#                  [AC_CHECK_HEADER(Judy.h,
#                     [AC_CHECK_LIB(Judy, JudySLIns, [
#                      hashes="judy";
#                      AC_DEFINE(HAVE_JUDY, 1, use Judy hashes)],
#                      AC_MSG_NOTICE([Optional library Judy hashes not found. This is not serious at all; we'll look for hashes elsewhere.])
#                      )],)])])
#AC_SUBST(judy_cflags)
#AC_SUBST(judy_libs)



valgrind="no"
PKG_CHECK_MODULES(VALGRIND,valgrind,[AC_DEFINE(HAVE_VALGRIND, 1, build with valgrind detection)],
                                    [AC_MSG_NOTICE([Building without valgrind detection -- if you don't know what this means, you don't need this])])
AC_SUBST(VALGRIND_CFLAGS)
AC_SUBST(VALGRIND_LIBS)



btrace=no
AC_MSG_CHECKING(whether to link in libbtrace)
AC_ARG_ENABLE(btrace, AC_HELP_STRING([--enable-btrace],[build with extra debugging using libbtrace]),
        [ ac_btrace="$enableval" ],
        [ ac_btrace="no" ]
        )
if test X"$ac_btrace" = Xyes; then
  AC_CHECK_HEADER(btrace.h,
                  [AC_CHECK_LIB(btrace, btrace_print,
                                [btrace_libs="-lbtrace"
                                 btrace=yes
                                 AC_DEFINE(HAVE_BTRACE, 1, add support for libbtrace)])])
fi
AC_SUBST(btrace_cflags)
AC_SUBST(btrace_libs)



doodle=no
AC_MSG_CHECKING(whether searching using libdoodle is explicitly disabled)
AC_ARG_ENABLE(doodle, AC_HELP_STRING([--enable-doodle],[build with libdoodle searches]),
        [ ac_doodle="$enableval" ],
        [ ac_doodle="yes" ]
        )
if test X"$ac_doodle" = Xyes; then
  AC_CHECK_HEADER(/usr/local/include/doodle.h,
                  [doodle_cflags=" "
                   doodle_libdir="/usr/local/lib"],
                  [AC_CHECK_HEADER(/usr/include/doodle.h,
                                   [doodle_cflags=" "
                                    doodle_libdir="/usr/lib"],
                                   [AC_CHECK_HEADER(/usr/include/doodle/doodle.h,
                                                    [doodle_libdir="/usr/lib/doodle"
                                                     doodle_libs="-L$doodle_libdir"
                                                     doodle_cflags=" -I/usr/include/doodle "],
                                                    [doodle_cflags=""])])])
  if test X"$doodle_cflags" != X; then
    save_LIBS="$LIBS"
    LIBS="$doodle_libs $LIBS"
    AC_CHECK_LIB(doodle, DOODLE_tree_search,
                 [doodle=yes
                  AC_DEFINE_UNQUOTED([DOODLE_LIBDIR], "$doodle_libdir", [where the doodle lib lives])
                  AC_DEFINE(HAVE_DOODLE, 1, add support for libdoodle searches)],
                 [doodle="no"])
    LIBS="$save_LIBS"
  fi
  if test X"$doodle" != Xyes; then
    AC_MSG_WARN([building without libdoodle, no searching!  (http://www.ovmj.org/doodle/)])
  fi
fi

AC_SUBST(doodle_cflags)
AC_SUBST(doodle_libs)



AC_CHECK_HEADER(wordexp.h,AC_DEFINE(HAVE_WORDEXP, 1, [whether wordexp is present; otherwise glob will be used]))








dnl ###########################################################################
dnl # checking for Qt
dnl ###################

if test "$QTDIR" = ""
then
  QTDIR=/usr/lib/qt3
  export QTDIR
fi

if test -d $QTDIR
then
  qt_dir=$QTDIR
fi
if test "$qt_dir" != ""
then
  qt_cxxflags="-I$qt_dir/include"
  qt_libadd="-L$qt_dir/lib -lqt"
  MOC="$qt_dir/bin/moc"
fi
AC_SUBST(qt_dir)
AC_SUBST(qt_cxxflags)
AC_SUBST(qt_libadd)
AC_SUBST(MOC)



AC_ARG_WITH(kde,
            AC_HELP_STRING([--with-kde=DIR],[use KDE in <DIR>]),
            [kde_cxxflags="-I$withval/include"
             kde_dir="$withval"
             kde_libs="-L$withval/lib"
             kde="yes"],
            [AC_CHECK_PROG([kde_config], [kde-config], yes)
             if test "$kde_config" = "yes"; then
               kde_dir=`kde-config --prefix`;
               kde_cxxflags="-I$kde_dir/include";
               kde_libs="-L$kde_dir/lib";
               kde="yes"
             fi])
AC_SUBST(kde_dir)
AC_SUBST(kde_cxxflags)
AC_SUBST(kde_libadd)
if test "$kde_dir" != ""
then
  kde_rpath="-R$kde_dir/lib"
  DCOPIDL="$kde_dir/bin/dcopidl"
  DCOPIDL2CPP="$kde_dir/bin/dcopidl2cpp"
fi
AC_SUBST(kde_rpath)
AC_SUBST(DCOPIDL)
AC_SUBST(DCOPIDL2CPP)

if test "$kde" = "yes"; then
  AC_CHECK_PROG([moc], [moc], yes)
  AC_CHECK_PROG([dcopidl], [dcopidl], yes)
  if test "$moc" = "yes" -a "$dcopidl" = "yes"; then
    AC_DEFINE(HAVE_KDE, 1, use KDE)
  fi
fi






dnl ###########################################################################
dnl # checking for IPC
dnl ###################

dbus="";
AC_MSG_CHECKING(whether to support DBus IPC)
AC_ARG_ENABLE(dbus, AC_HELP_STRING([--enable-dbus],[support DBus IPC]),
                [ ac_use_dbus="$enableval" ],
                [ ac_use_dbus="no" ]
                )
if test X"$ac_use_dbus" = Xyes; then
  AC_ARG_WITH(dbus,
            AC_HELP_STRING([--with-dbus=DIR],[use DBus in <DIR>]),
            [dbus="DBus "
             dbus_cflags="-I$withval/include"
             dbus_libs="-L$withval/lib"
             AC_DEFINE(HAVE_DBUS, 1, use DBus)],
            [PKG_CHECK_MODULES(DBUS, dbus-1 >= 0.12,
                               [dbus="DBus "
                                dbus_cflags=`pkg-config --cflags dbus-1`
                                dbus_libs=`pkg-config --libs dbus-1`
                                AC_DEFINE(HAVE_DBUS, 1, use DBus)],
                                AC_MSG_NOTICE("Building without highly experimental DBUS support..."))])
else
  AC_MSG_RESULT(no)
fi
AC_SUBST(dbus_cflags)
AC_SUBST(dbus_libs)



dcop=""
AC_MSG_CHECKING(whether to support KDE DCOP IPC)
AC_ARG_ENABLE(dcop, AC_HELP_STRING([--enable-dcop],[support KDE DCOP IPC]),
                [ ac_use_dcop="$enableval" ],
                [ ac_use_dcop="no" ]
                )
if test X"$ac_use_dcop" = Xyes; then
  AC_ARG_WITH(dcop,
            AC_HELP_STRING([--with-dcop=DIR],[use DCOP in <DIR>]),
            [dcop_cxxflags="-I$withval/include"
             dcop_libs="-L$withval/lib -lDCOP"
             dcop="DCOP "
             AC_DEFINE(HAVE_DCOP, 1, use DCOP)],
            [if test "$kde_dir" != ""; then
               AC_MSG_CHECKING(for DCOP in $kde_dir)
               if test -f "$kde_dir/include/dcopobject.h" -a -f "$kde_dir/lib/libDCOP.so"; then
                 AC_MSG_RESULT(yes)
                 dcop_cxxflags="-I$kde_dir/include";
                 dcop_libs="-L$kde_dir/lib -lDCOP";
                 dcop="DCOP "
                 AC_DEFINE(HAVE_DCOP, 1, use DCOP)
               else
                 AC_MSG_RESULT(no)
               fi
             fi])
else
  AC_MSG_RESULT(no)
fi
AC_SUBST(dcop_cxxflags)
AC_SUBST(dcop_libs)



ecoreipc=""
AC_ARG_ENABLE(ecore-ipc, AC_HELP_STRING([--enable-ecore-ipc],[support eCore IPC (required for evsh and examine)]),
                [ ac_use_ecoreipc="$enableval" ],
                [ ac_use_ecoreipc="yes" ]
                )

ecore=""
AC_MSG_CHECKING(whether to use eCore as main-loop)
AC_ARG_ENABLE(ecore, AC_HELP_STRING([--enable-ecore],[use eCore as main-loop]),
                [ ac_use_ecore="$enableval" ],
                [ ac_use_ecore="yes" ]
                )

if test X"$ac_use_ecore" = Xno; then
#  if test X"$ac_use_ecoreipc" = Xyes; then
#    AC_MSG_RESULT([forced by inclusion of eCore-IPC])
#    ac_use_ecore="forced"
#  else
    AC_MSG_RESULT([no])
#  fi
else
  AC_MSG_RESULT([no])
fi

if test X"$ac_use_ecore" != Xno; then
  AC_PATH_GENERIC(ecore, 1.0.0, [
                AC_CHECK_LIB(ecore,ecore_main_loop_iterate,[
                  ecore_cflags=`ecore-config --cflags`
                  ecore_libs=`ecore-config --libs`
                  ecore=yes
                  if test X"$ac_use_ecore" = Xyes; then
                    loop=eCore
                    AC_DEFINE(HAVE_ECORE, 1, have enlightened main loop)
                    AC_MSG_NOTICE([Building with eCore mainloop. This is an important change; let the developers now if you notice something strange. If it does, you can get back the old glib-build by selecting it in the configure-run.])
                  fi
                ],[
                  AC_MSG_NOTICE([ecore too old! no enlightened main-loop for you! you come back -- one year!])])],[
                AC_MSG_NOTICE([ecore-config not found. no enlightened IPC.])])
fi

AC_MSG_CHECKING(whether to support eCore IPC)
if test X"$ac_use_ecoreipc" = Xyes; then
                  AC_MSG_CHECKING(for eCore-IPC in eCore)
                  if test `ecore-config --libs|sed -e 's/.* -lecore_ipc.*/X/g'` = "X"; then
                    ecore_ipc_libs=`ecore-config --libs`
                    ecore_ipc_cflags=`ecore-config --cflags`
                    AC_DEFINE(HAVE_ECORE_IPC, 1, have enlightened IPC)
                    ecoreipc="eCore-IPC "
                    AC_MSG_RESULT(yes)
                  else
                    AC_MSG_RESULT(no)
                  fi
fi

AC_SUBST(ecore_libs)
AC_SUBST(ecore_cflags)

AC_SUBST(ecore_ipc_libs)
AC_SUBST(ecore_ipc_cflags)






dnl ###########################################################################
dnl # Canvas selection
dnl ###################

iconview=none;
libpng="";
imlib2="";

AC_MSG_CHECKING(whether support for evas2 is to be built)
AC_ARG_ENABLE(canvas-evas2, AC_HELP_STRING([--enable-canvas-evas2],[use evas2 as canvas (enables theming)]),
        [ ac_use_canvas_evas2="$enableval" ],
        [ ac_use_canvas_evas2="yes" ]
        )
if test X"$ac_use_canvas_evas2" = Xyes; then
        AC_MSG_RESULT(yes)
                AC_ARG_WITH(evas,
                   AC_HELP_STRING([--with-evas2=DIR],[use evas2 in <DIR>]),
                   [evas_cflags="-I$withval/include"
                   evas_libs="-L$withval/lib"],[
                   AC_PATH_GENERIC(evas, 1.0.0, [
                                   evas_cflags=`evas-config --cflags`
                                   evas_libs=`evas-config --libs`
                                   evas=yes;],[
                                   AC_MSG_WARN(Without evas there will be no theming.)
                                   evas=no; ])])
                AC_SUBST(evas_libs)
                AC_SUBST(evas_cflags)
                if test "$evas" = "yes"; then
                  AC_DEFINE(HAVE_EVAS2, 1, Use evas2 for a canvas (enables theming))
                fi

                if test "$hashes" = "none"; then
                  hashes=evas;
                fi
                iconview=evas;

                # check for edb
                AC_PATH_GENERIC(edb, 1.0.2, [
                  edb_cflags=`edb-config --cflags`
                  edb_libs=`edb-config --libs`
                  AC_DEFINE(HAVE_EDB, 1, have enlightened database library)
                  edb=yes;
                ],[
                  AC_MSG_WARN([Without the enlightened database library some legacy plugins may be unable to load their data.])
                  edb=no;
                ])
                AC_SUBST(edb_libs)
                AC_SUBST(edb_cflags)
        
                # check for eet
                AC_PATH_GENERIC(eet, 0.0.0, [
                  eet_cflags=`eet-config --cflags`
                  eet_libs=`eet-config --libs`
                  eet=yes
                  AC_DEFINE(HAVE_EET, 1, have enlightened compression library)
                ],[
                  AC_MSG_WARN([Without the enlightened compression library some plugins may be unable to load their data.])
                  eet=no;
                ])
                AC_SUBST(eet_libs)
                AC_SUBST(eet_cflags)

                # check for edje
                edje="no"
                AC_MSG_CHECKING(whether to support edje themes)
                AC_ARG_ENABLE(ecore, AC_HELP_STRING([--enable-edje],[support edje themes]),
                              [ ac_use_edje="$enableval" ],
                              [ if test X"$ac_use_ecore" = Xno; then
                                  ac_use_edje="no"
                                else
                                  ac_use_edje="yes"
                                fi ])
                AC_MSG_RESULT([$ac_use_edje])

                if test X"$ac_use_edje" = Xyes; then
                  if test X"$ac_use_ecore" = Xno; then
                    AC_MSG_WARN([edje requested -- this will pull in eCore via the backdoor...])
                  fi

                  AC_PATH_GENERIC(edje, 0.5.0, [
                    edje_cflags=`edje-config --cflags`
                    edje_libs=`edje-config --libs`
                    edje="yes";
                    AC_DEFINE(HAVE_EDJE, 1, have enlightened skinning)
                  ],[
                    AC_MSG_WARN([Without enlightened skinning support, some background-plugins may be unable to build.])
                  ])
                fi

                AC_SUBST(edje_libs)
                AC_SUBST(edje_cflags)

                # check for ebg
#               AC_PATH_GENERIC(ebg, 1.0.0, [
#                 ebg_cflags=`ebg-config --cflags`
#                 ebg_libs=`ebg-config --libs`
#                 ebg=yes;
#                 AC_DEFINE(HAVE_EBG, 1, have enlightened background database library)
#               ],[
#                 AC_MSG_WARN([Without the enlightened background handler some background-plugins may be unable to build.])
#                 ebg=no;
#               ])
#               AC_SUBST(ebg_libs)
#               AC_SUBST(ebg_cflags)

                # check for ebits
#               AC_PATH_GENERIC(ebits, 1.0.1, [
#                 ebits_cflags=`ebits-config --cflags`
#                 ebits_libs=`ebits-config --libs`
#                 ebits=yes;
#                 AC_DEFINE(HAVE_EBITS, 1, have enlightened micro-widget library)
#               ],[
#                 AC_MSG_WARN([Without the ebits library some legacy plugins may be unable to load their data.])
                  ebits=no;
#               ])
#               AC_SUBST(ebits_libs)
#               AC_SUBST(ebits_cflags)

                # check for evas-gl
                evas_gl="no";
                AC_CHECK_HEADER(Evas_Engine_GL_X11.h,[
                        AC_DEFINE(HAVE_EVAS_GL, 1,[evas was built with the GL_X11 rendering method])
                        evas_gl="yes"],
                        ,[#include <Evas.h>])

#               if test "$evas_buffer" = "no"; then
#                 AC_MSG_NOTICE([Provided evas-library does not support the buffer engine.])
#               fi

                # check for evas-buffer
#               evas_buffer="no";
#               save_CFLAGS="$CFLAGS"
#               save_LIBS="$LIBS"
#               CFLAGS="$save_CFLAGS $evas_cflags"
#               LIBS="$save_LIBS $evas_libs"
#               AC_CHECK_LIB(evas, evas_buffer_outbuf_buf_init,[
#                   AC_CHECK_HEADER(Evas_Engine_Buffer.h,[
#                       AC_MSG_RESULT(yes)
#                       AC_DEFINE(HAVE_EVAS_BUFFER, 1,[evas was built with the buffer rendering method -- we can use that in thumbnailing if imlib2 leaks])
#                       evas_buffer="yes"],
#                       AC_MSG_RESULT(no),[#include <Evas.h>])],,)
#               LIBS="$save_LIBS"
#               CFLAGS="$save_CFLAGS"

#               if test "$evas_buffer" = "no"; then
#                 AC_MSG_NOTICE([Provided evas-library does not support the buffer engine.])
#               fi

else
        AC_MSG_RESULT(no)
        evas=no;
        all_themes=no;
fi






AC_MSG_CHECKING(whether support for gnomecanvas is to be built)
AC_ARG_ENABLE(canvas-gnomecanvas, AC_HELP_STRING([--enable-canvas-gnomecanvas],[use gnomecanvas as canvas]),
        [ ac_use_canvas_gnomecanvas="$enableval" ],
        [ ac_use_canvas_gnomecanvas="no" ]
        )
if test X"$ac_use_canvas_gnomecanvas" = Xyes; then
        AC_MSG_RESULT(yes)
                AC_ARG_WITH(gnomecanvas,
                   AC_HELP_STRING([--with-gnomecanvas=DIR],[use gnomecanvas in <DIR>]),
                   [gnomecanvas_cflags="-I$withval/include"
                   gnomecanvas_libs="-L$withval/lib"],
                   [PKG_CHECK_MODULES(EVIDENCE,
                                       libart-2.0
                                       libgnomecanvas-2.0
                                     )
                    gnomecanvas_libs=`pkg-config --libs libgnomecanvas-2.0`
                    gnomecanvas_cflags=`pkg-config --cflags libgnomecanvas-2.0`])
                AC_DEFINE(HAVE_GNOMECANVAS, 1, Use gnomecanvas for canvas (no theming))
                gnomecanvas=yes;
                iconview="GNOME-canvas";
                AC_MSG_WARN([Building with gnome-canvas is a legacy feature that isn't test very frequently, so your build may break, or shelf and icon-view may not work 100 %. Even if they do, there will be no theming except for iconsets.])
else
        AC_MSG_RESULT(no)
                gnomecanvas=no;
                if test "$evas" = "no"; then
                  AC_MSG_WARN([Neither evas nor GNOME-canvas selected, building without icon-view and shelf!])
                fi
fi
AC_SUBST(gnomecanvas_libs)
AC_SUBST(gnomecanvas_cflags)






dnl ###########################################################################
dnl # thumbnailer
dnl ############



# check for Imlib2
AC_PATH_GENERIC(imlib2,,[imlib2_libs=`imlib2-config --libs`
                         imlib2_cflags=`imlib2-config --cflags`
                         AC_DEFINE(HAVE_IMLIB2, 1, have Imlib2)
                         imlib2="Imlib2 "; ],[
                         AC_MSG_WARN([Without Imlib2 the number of image formats we can create thumbnails for will be greatly reduced. Getting Imlib2 is recommended.])
                        ])
AC_SUBST(imlib2_libs)
AC_SUBST(imlib2_cflags)



# check for libpng
AC_ARG_WITH(libpng,
            AC_HELP_STRING([--with-libpng=DIR],[use libPNG in <DIR>]),
                           [libpng="PNG "
                            libpng_cflags="-I$withval/include"
                            libpng_libs="-L$withval/lib"
                            AC_DEFINE(HAVE_LIBPNG,1,[have libpng for thumbnailing])],
                           [AC_PATH_GENERIC(libpng,,[libpng_libs=`libpng-config --libs`
                                                     libpng_cflags=`libpng-config --cflags`
                                                     libpng="PNG "
                                                     AC_DEFINE(HAVE_LIBPNG, 1,[have libpng for thumbnailing])],
                                                    [PKG_CHECK_MODULES(PNG,libpng12,
                                                      [libpng="PNG "
                                                       libpng_cflags=`pkg-config --cflags libpng12`
                                                       libpng_libs=`pkg-config --libs libpng12`
                                                       libpng="PNG "
                                                       AC_DEFINE(HAVE_LIBPNG, 1,[have libpng for thumbnailing])],
                                                      [AC_MSG_WARN([blubbadupbleepblopbleet])])])])

if test "$libpng_libs" != ""; then
  libpng_libs="$libpng_libs -lz -lm"
fi
AC_SUBST(libpng_cflags)
AC_SUBST(libpng_libs)
if test "$libpng" = ""; then
  AC_MSG_WARN([Building without PNG image library libpng -- disabling thumbnail image previews!!])
fi



# check for epeg
epeg="ePEG "
# AC_PATH_GENERIC(epeg, 0.0.1, [
#                 epeg_cflags=`epeg-config --cflags`
#                 epeg_libs=`epeg-config --libs`
#                 epeg="ePEG "
                  AC_DEFINE(HAVE_EPEG, 1, have enlightened ultra-fast JPEG thumbnailer)
#                 ],[
#                 AC_MSG_WARN([Without the enlightened JPEG thumbnailer creating previews for large JPEG images will be significantly slower. Nevermind if you don't have a lot of large JPEGs (from your digital camera or somesuch).])
#                 epeg="";
#                 ])
# AC_SUBST(epeg_libs)
# AC_SUBST(epeg_cflags)
# Test for libjpeg
AC_CHECK_LIB(jpeg,jpeg_destroy_decompress,
  AC_TRY_CPP(
  [#include <stdio.h>
   #undef PACKAGE
   #undef VERSION
   #include <jpeglib.h>],
  jpeg=yes,
  jpeg=no))
if test "$jpeg" = yes; then
  libjpeg_libs="-ljpeg"
else
  AC_MSG_WARN(*** JPEG support will not be built ***)
  epeg=""
fi
AC_SUBST(libjpeg_cflags)
AC_SUBST(libjpeg_libs)







dnl ###########################################################################
dnl # Checks for the extra fu
dnl ############

AC_MSG_CHECKING(whether all themes are to be built)
AC_ARG_ENABLE(extra-themes, AC_HELP_STRING([--enable-extra-themes],[build ugly debug-themes as well]),
        [ ac_use_all_themes="$enableval" ],
        [ ac_use_all_themes="no" ]
        )
if test X"$ac_use_all_themes" = Xyes -a X"$ac_use_canvas_evas2" = Xyes; then
        AC_MSG_RESULT(yes)
                all_themes=yes;
else
        AC_MSG_RESULT(no)
                all_themes=no;
                AC_MSG_NOTICE(Not installing experimental and legacy themes -- it's probably better that way.)
fi

AC_MSG_CHECKING(whether all iconsets are to be install)
AC_ARG_ENABLE(extra-iconsets, AC_HELP_STRING([--enable-extra-iconsets],[install all icon-sets]),
        [ ac_use_all_iconsets="$enableval" ],
        [ ac_use_all_iconsets="no" ]
        )
if test X"$ac_use_all_iconsets" = Xyes -a X"$ac_use_canvas_evas2" = Xyes; then
        AC_MSG_RESULT(yes)
                all_iconsets=yes;
else
                if test X"$all_themes" = Xyes; then
                  AC_MSG_RESULT(yes -- implied by --enable-extra-themes)
                  all_iconsets=yes;
                else
                  AC_MSG_RESULT(no)
                  AC_MSG_NOTICE(Not installing legacy icon-sets -- just as well.)
                  all_iconsets=no;
                fi
fi






