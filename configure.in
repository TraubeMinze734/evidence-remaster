dnl ###########################################################################
dnl # Checking for additional libs for POSIX-backend
dnl ###################

AC_CHECK_LIB(c,readdir_r,[threading="with threads";
                          AC_DEFINE(HAVE_READDIR_R,1,have readdir_r)],
                         [threading="without threads"])



if test "$posix" = "yes"; then



dnl Check for curl.
curl="without libcurl"
AC_PATH_GENERIC(curl,7.0.0,
                [curl="with libcurl"
                 AC_DEFINE(HAVE_LIBCURL, 1, have curl downloader)
                 curl_cflags=`curl-config --cflags`
                 curl_libs=`curl-config --libs`])
AC_SUBST(curl_cflags)
AC_SUBST(curl_libs)



dnl Check for libattr.
libattr="without EAs";
AC_MSG_CHECKING(whether to use Extended Attributes (EAs) in POSIX backend)
AC_ARG_ENABLE(attrs, AC_HELP_STRING([--enable-attrs],[support Extended Attributes in POSIX backend if library present at run-time]),
        [ ac_use_attrs="$enableval" ],
        [ ac_use_attrs="yes" ]
        )
if test X"$ac_use_attrs" = Xyes; then
        AC_MSG_RESULT(yes)
                AC_ARG_WITH(attr,
                   AC_HELP_STRING([--with-attr=DIR],[use libattr (Extended Attributes) in <DIR>]),
                   [attr_cflags="-I$withval/include"
                   attr_libs="-L$withval/lib -lattr"
                   libattr="with EAs";
                   AC_DEFINE(HAVE_LIBATTR, 1, Use Extended Attributes in POSIX backend)],
                   [AC_CHECK_HEADER(attr/xattr.h,
                      [libattr="with EAs";
                      attr_libs="-lattr";
                      AC_DEFINE(HAVE_LIBATTR, 1, Use Extended Attributes in POSIX backend)],,)])
                if test "$libattr" != "without EAs"; then
                  AC_CHECK_LIB(attr, attr_copy_file,
                    AC_DEFINE(HAVE_ATTR_COPY_FILE, 1, have convenience function to copy EAs),,)
                fi
else
        AC_MSG_RESULT(no)
fi
AC_SUBST(attr_libs)
AC_SUBST(attr_cflags)



dnl Check for libacl.
libacl="without ACLs";
AC_MSG_CHECKING(whether to use Access Control Lists (ACLs) in POSIX backend)
AC_ARG_ENABLE(acls, AC_HELP_STRING([--enable-acls],[use Access Control Lists in POSIX backend if library present at run-time]),
        [ ac_use_acls="$enableval" ],
        [ ac_use_acls="yes" ]
        )
if test X"$ac_use_acls" = Xyes; then
                AC_MSG_RESULT(yes)
                AC_ARG_WITH(acls,
                   AC_HELP_STRING([--with-acls=DIR],[use acls in <DIR>]),
                   [acl_cflags="-I$withval/include"
                   acl_libs="-L$withval/lib -lacl"
                   libacl="with ACLs";
                   AC_DEFINE(HAVE_LIBACL, 1, Use Access Control Lists in POSIX backend)],
                   [AC_CHECK_HEADER(sys/acl.h,
                      [AC_CHECK_HEADER(acl/libacl.h,
                        [libacl="with ACLs";
                        acl_libs="-lacl";
                        AC_DEFINE(HAVE_LIBACL, 1, Use Access Control Lists in POSIX backend)],,)],,)])
                AC_CHECK_LIB(acl, perm_copy_file,
                  AC_DEFINE(HAVE_PERM_COPY_FILE, 1, have convenience function to copy ACLs),,)
else
        AC_MSG_RESULT(no)
fi
AC_SUBST(acl_libs)
AC_SUBST(acl_cflags)



dnl Check for libmagic.
libmagic="without libmagic MIME-determination";
AC_MSG_CHECKING(whether to use the MIME-determination functions of the "file"-command (libmagic) in POSIX backend)
AC_ARG_ENABLE(magic,AC_HELP_STRING([--enable-libmagic],[use libmagic MIME-determination in POSIX backend if library present at run-time]),
        [ ac_use_magic="$enableval" ],
        [ ac_use_magic="yes" ]
        )
if test X"$ac_use_magic" = Xyes; then
        AC_MSG_RESULT(yes)
                AC_ARG_WITH(libmagic,
                   AC_HELP_STRING([--with-libmagic=DIR],[use libmagic in <DIR>]),
                   [libmagic_cflags="-I$withval/include"
                   libmagic_libs="-L$withval/lib -lmagic"
                   libmagic="with libmagic MIME-determination";
                   AC_DEFINE(HAVE_LIBMAGIC, 1, Use MIME-determination of the file-command (libmagic) in POSIX backend)],
                   [AC_CHECK_HEADER(magic.h,
                      [AC_CHECK_LIB(magic, magic_file,
                        [libmagic="with libmagic MIME-determination";
                        libmagic_libs="-lmagic";
                        AC_DEFINE(HAVE_LIBMAGIC, 1, Use MIME-determination of the file-command (libmagic) in POSIX backend)],,)],,)])
else
        AC_MSG_RESULT(no)
fi
AC_SUBST(libmagic_libs)
AC_SUBST(libmagic_cflags)



dnl Check for gnome-mime-data.
gmd2=`pkg-config --variable=prefix gnome-mime-data-2.0`
if test -d "$gmd2"
then
  gmd2_apps="$gmd2/share/application-registry/gnome-vfs.applications"
fi



#dnl Check for libshared-mime.
libsharedmime="without freedesktop.org MIME-determination";
AC_MSG_CHECKING(whether to use the freedesktop.org MIME-determination functions (libshared-mime) in POSIX backend)
AC_ARG_ENABLE(sharedmime, AC_HELP_STRING([--enable-sharedmime],[use freedesktop.org MIME-determination (libsharedmime) in POSIX backend]),
                [ ac_use_libsharedmime="$enableval" ],
                [ ac_use_libsharedmime="yes" ]
                )
save_CFLAGS="$CFLAGS"
save_LIBS="$LIBS"
if test X"$ac_use_libsharedmime" = Xyes; then
               AC_MSG_RESULT(yes)
               AC_ARG_WITH(libsharedmime,
                  AC_HELP_STRING([--with-libsharedmime=DIR],[use libsharedmime in <DIR>]),
                  [libsharedmime_CFLAGS="-I$withval/include"
                  libsharedmime_LIBS="-L$withval/lib -lsharedmime1d"
                  libsharedmime="with freedesktop.org MIME-determination"],

                  [CFLAGS=`pkg-config --cflags libshared-mime1`

                   AC_LANG_PUSH(C++)
                   AC_CHECK_LIB(sharedmime1d, mimetypes_get_file_type,[
                     AC_CHECK_HEADER(mime-types.h,
                       [libsharedmime="with freedesktop.org MIME-determination (LGPL)"])])
                   AC_LANG_POP(C++)

                   AC_CHECK_LIB(sharedmime1, mimetypes_get_file_type,[
                       libsharedmime_CFLAGS=$CFLAGS
                       PKG_CHECK_MODULES(libsharedmime, libshared-mime1 >= 0.1.1)
                       libsharedmime="with freedesktop.org MIME-determination (GPL)"])])
else
               AC_MSG_RESULT(no)
fi
LIBS="$save_LIBS"
CFLAGS="$save_CFLAGS"
AC_SUBST(libsharedmime_LIBS)
AC_SUBST(libsharedmime_CFLAGS)
if test "$libsharedmime" = "without freedesktop.org MIME-determination"; then
  if test "$libmagic" = "without libmagic MIME-determination"; then
    AC_MSG_WARN([Optional library libshared-mime not found -- if you aren't using the default (POSIX) file-system backend, this doesn't matter. If you are, this still isn't serious, but MIME-type determination might be slightly less precise in the POSIX backend this way. If you wish, install either of the following packages to amend this: http://www.freedesktop.org/software/shared-mime-info/ http://freshmeat.net/releases/117640/])
  fi
else
  AC_DEFINE(HAVE_LIBSHAREDMIME, 1, Use freedesktop.org MIME-determination (libsharedmime) in POSIX backend)
fi



dnl Check for fam.
save_LIBS="$LIBS"
save_CFLAGS="$CFLAGS"
AC_ARG_WITH(fam,
       AC_HELP_STRING([--with-fam=DIR],[use DIR where fam is installed.]),
       [fam_cflags="-I$withval/include"; fam_libs="-L$withval/lib -lfam";
        CFLAGS="$CFLAGS -I$withval/include"; LIBS="$LIBS -L$withval/lib -lfam"; ],
       [fam_cflags=""; fam_libs="-lfam"])
AC_CHECK_HEADER(fam.h, , fam_header_ok="no")
AC_CHECK_LIB(fam, main, , fam_lib_ok="no")
if test "$fam_header_ok" = "no" -o "$fam_lib_ok" = "no"; then
  fam="without FAM (file-alteration monitor) support";
  AC_MSG_WARN(Optional library FAM not found -- this is not a problem.)
else
  fam="with FAM (file-alteration monitor) support";
  AC_DEFINE(HAVE_FAM, 1, try to use File-alteration monitor)
fi;
LIBS="$save_LIBS"
CFLAGS="$save_CFLAGS"
AC_SUBST(fam_cflags)
AC_SUBST(fam_libs)



dnl Check for F_NOTIFY.
dnl We don't really have to, but it's nice to let the user know in the summary.
AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
#define _GNU_SOURCE
#include <fcntl.h>
]],[[int x=F_NOTIFY;]])],[fnotify="with F_NOTIFY support"],
                         [fnotify="without F_NOTIFY support"])

fi   # test "posix"






dnl ###########################################################################
dnl # checking for providers
dnl ###################

save_LIBS="$LIBS"



dnl ###################
dnl # checking for extractor (provider)
dnl ###################

extractor=no;
AC_MSG_CHECKING(whether the extractor plugin is explicitly disabled)
AC_ARG_ENABLE(plugin-extractor, AC_HELP_STRING([--enable-plugin-extractor],[build the file keywords plugin]),
        [ ac_use_plugin_extractor="$enableval" ],
        [ ac_use_plugin_extractor="yes" ]
        )
if test X"$ac_use_plugin_extractor" = Xyes; then
        AC_MSG_RESULT(no)
     AC_CHECK_LIB(extractor, EXTRACTOR_getKeywords,[
       extractor=yes
       extractor_libs="-lextractor"
       extractor_cflags=""
       AC_DEFINE(HAVE_EXTRACTOR, 1, libextractor keyword-library found)],[
       extractor=no
       AC_MSG_WARN([Could not find all headers and libraries for extractor support: there will be fewer metadata in tooltips. cf. http://www.ovmj.org/samanta/libextractor/ ])])
else
        AC_MSG_RESULT(yes)
     extractor=no
fi
AC_SUBST(extractor_libs)
AC_SUBST(extractor_cflags)



dnl ###################
dnl # checking for taglib (provider)
dnl ###################

taglib=no;
AC_MSG_CHECKING(whether the taglib plugin is explicitly disabled)
AC_ARG_ENABLE(plugin-taglib, AC_HELP_STRING([--enable-plugin-taglib],[build the taglib plugin for tagged MP3, Ogg-Vorbis, FLAC, ... files]),
              [ ac_use_plugin_taglib="$enableval" ],
              [ ac_use_plugin_taglib="yes" ]
             )
if test X"$ac_use_plugin_taglib" = Xyes; then
        AC_MSG_RESULT(no -- good)
        AC_ARG_WITH(taglib,
           AC_HELP_STRING([--with-taglib=DIR],[use taglib in <DIR>]),
           [TAGLIB_CFLAGS="-I$withval/include"
            TAGLIB_LIBS="-L$withval/lib -ltag"
            taglib=yes],
           [AC_PATH_GENERIC(taglib, 1.3,
                            [TAGLIB_CFLAGS=`taglib-config --cflags`
                             TAGLIB_LIBS=`taglib-config --libs`
                             taglib=yes;],
                            [taglib=no; ])])

        if test "$taglib" = "no"; then
          AC_MSG_WARN([Could not find all headers and libraries for taglib.])
        else
          AC_DEFINE(HAVE_TAGLIB, 1, "taglib found")
        fi
else
        AC_MSG_RESULT(yes)
fi
AC_SUBST(TAGLIB_LIBS)
AC_SUBST(TAGLIB_CFLAGS)



dnl ###################
dnl # checking for vorbis (provider)
dnl ###################

vorbisfile=no;
AC_MSG_CHECKING(whether the vorbis plugin is explicitly disabled)
AC_ARG_ENABLE(plugin-vorbis, AC_HELP_STRING([--enable-plugin-vorbis],[buid the file info plugin for vorbis (ogg) files]),
        [ ac_use_plugin_vorbis="$enableval" ],
        [ if test "$taglib" = "no"; then
            ac_use_plugin_vorbis="yes"
          else
            # change to "no" once taglib is fully supported
            ac_use_plugin_vorbis="yes"
          fi ])
if test X"$ac_use_plugin_vorbis" = Xyes; then
        AC_MSG_RESULT(no -- good)
        AC_ARG_WITH(libvorbis,
           AC_HELP_STRING([--with-libvorbis=DIR],[use libvorbis in <DIR>]),
           [vorbis_cflags="-I$withval/include"
            vorbis_libs="-L$withval/lib -lvorbis -logg -vorbisfile"
            vorbisfile=yes],
           [AC_CHECK_LIB(vorbis, vorbis_comment_clear,[
            AC_CHECK_HEADER(vorbis/vorbisfile.h,[
              AC_CHECK_LIB(ogg, ogg_sync_wrote,[
                vorbisfile=yes
                vorbis_libs='-lvorbis -logg -lvorbisfile'],)],)],)])

        if test "$vorbisfile" = "no"; then
          AC_MSG_WARN([Could not find all headers and libraries for ogg/vorbis, a free alternative to MP3: there will be no editing of vorbis-comments and no Ogg-Vorbis info in tooltips.])
        else
          AC_DEFINE(HAVE_VORBIS, 1, "libvorbis, libvorbisfile and libogg found")
        fi
else
        AC_MSG_RESULT(yes)
fi
AC_SUBST(vorbis_libs)
AC_SUBST(vorbis_cflags)



dnl ###################
dnl # checking for mp3/id3 (provider)
dnl ###################

id3=no;
save_CFLAGS="$CFLAGS"
save_LIBS="$LIBS"
AC_MSG_CHECKING(whether the id3 plugin is explicitly disabled)
AC_ARG_ENABLE(plugin-id3, AC_HELP_STRING([--enable-plugin-id3],[build the file info plugin for mp3 files]),
        [ ac_use_plugin_id3="$enableval" ],
        [ if test "$taglib" = "no"; then
            ac_use_plugin_id3="yes"
          else
            # change to "no" once taglib is fully supported
            ac_use_plugin_id3="yes"
          fi ])
if test X"$ac_use_plugin_id3" = Xyes; then
        AC_MSG_RESULT(no)
        AC_SEARCH_LIBS(ID3Tag_CreateIterator, "id3 -lz -lstdc++",[
          id3=yes
          id3_libs="-lz -lid3 -lstdc++"
          AC_DEFINE(HAVE_ID3, 1, libid3 found)],[
            id3=no
            AC_MSG_WARN([Could not find all headers and libraries for MP3/ID3 song support: there will be no editing of MP3-tags and no MP3 info in tooltips.])])
else
        AC_MSG_RESULT(yes)
        id3=no
fi
AC_SUBST(id3_libs)
AC_SUBST(id3_cflags)
LIBS="$save_LIBS"
CFLAGS="$save_CFLAGS"



dnl ###################
dnl # checking for xine/emotion (thumbnailer)
dnl ###################

xine=""
AC_MSG_CHECKING(whether the xine thumbnailer was explicitly disabled)
AC_ARG_ENABLE(thumbnailer-xine, AC_HELP_STRING([--enable-thumbnailer-xine],[build the thumbnailer for videos]),
        [ ac_use_plugin_xine="$enableval" ],
        [ ac_use_plugin_xine="yes" ]
        )
if test X"$ac_use_plugin_xine" = Xyes; then
        AC_MSG_RESULT(no)
        AC_ARG_WITH(libxine,
           AC_HELP_STRING([--with-libxine=DIR],[use libxine in <DIR>]),
           [xine_CFLAGS="-I$withval/include"
            xine_LIBS="-L$withval/lib -lxine"
            AC_DEFINE(HAVE_LIBXINE, 1, libxine thumbnailer)
            xine="xine "],
           [AC_PATH_GENERIC(xine, 1.0.0, [
              xine_cflags=`xine-config --cflags`
              xine_libs=`xine-config --libs`
              xine_plugins=`xine-config --plugindir`
              AC_DEFINE(HAVE_LIBXINE, 1, build xinefile thumbnailer)
              xine="xine "],[
              AC_MSG_WARN([libxine too old; no thumbnails for videos unless libmpeg3 and avifile are supplied...])])])
else
        AC_MSG_RESULT(yes)
        xine=""
fi
AC_SUBST(xine_LIBS)
AC_SUBST(xine_CFLAGS)
AC_SUBST(xine_PLUGINS)



EMOTION_LIBDIR=`pkg-config --variable=libdir emotion`
if test X"$EMOTION_LIBDIR" != "X"; then
  AC_DEFINE(HAVE_EMOTION, 1, emotion live video framework)
  AC_DEFINE_UNQUOTED([EMOTION_LIBDIR], "$EMOTION_LIBDIR", [where emotion's plugins live])
fi

# if test X"$xine" = "Xxine "; then
#   PKG_CHECK_MODULES(EMOTION, emotion >= 0.0.1,
#     [EMOTION_LIBDIR=`pkg-config --variable=libdir emotion`
#      AC_DEFINE(HAVE_EMOTION, 1, emotion live video framework)
#      AC_DEFINE_UNQUOTED([EMOTION_LIBDIR], "$EMOTION_LIBDIR", [where emotion's plugins live])],
#     [AC_MSG_WARN([emotion not found; no live thumbnails for videos...])])
# fi
# AC_SUBST(EMOTION_LIBS)
# AC_SUBST(EMOTION_CFLAGS)






dnl ###################
dnl # checking for avifile (thumbnailer)
dnl ###################

avi=""
AC_MSG_CHECKING(whether the avi thumbnailer was explicitly enabled)
AC_ARG_ENABLE(thumbnailer-avi, AC_HELP_STRING([--enable-thumbnailer-avi],[build the thumbnailer for AVI videos]),
        [ ac_use_plugin_avi="$enableval" ],
        [ ac_use_plugin_avi="no" ]
        )
if test X"$ac_use_plugin_avi" = Xyes; then
        AC_MSG_RESULT(no)
        AC_ARG_WITH(libavi,
           AC_HELP_STRING([--with-libavi=DIR],[use libavi in <DIR>]),
           [avi_CFLAGS="-I$withval/include"
            avi_LIBS="-L$withval/lib -lavi"
            AC_DEFINE(HAVE_AVIFILE, 1, libavi thumbnailer)
            avi="avi "],
           [PKG_CHECK_MODULES(avi, avifile >= 0.7.38,[
             AC_DEFINE(HAVE_AVIFILE, 1, build avifile thumbnailer)
             avi="avi "],[
             AC_MSG_WARN([libavi too old; no thumbnails for avi videos])])])
else
        AC_MSG_RESULT(yes)
        avi=""
fi
AC_SUBST(avi_LIBS)
AC_SUBST(avi_CFLAGS)



dnl ###################
dnl # checking for mpeg3 (thumbnailer)
dnl ###################

mpeg3=""
mpeg3_cflags=""
mpeg3_libs=""
save_CFLAGS="$CFLAGS"
save_LIBS="$LIBS"

AC_MSG_CHECKING(whether the mpeg thumbnailer was explicitly enabled)
AC_ARG_ENABLE(thumbnailer-mpeg3, AC_HELP_STRING([--enable-thumbnailer-mpeg3],[build the thumbnailer for mpeg videos]),
        [ ac_use_plugin_mpeg3="$enableval" ],
        [ ac_use_plugin_mpeg3="no" ]
        )
if test X"$ac_use_plugin_mpeg3" = Xyes; then
        AC_MSG_RESULT(no)
        AC_ARG_WITH(libmpeg3,
           AC_HELP_STRING([--with-libmpeg3=DIR],[use libmpeg3 in <DIR>]),
           [mpeg3_cflags="-I$withval/include -I$withval/include/libmpeg3"
            mpeg3_libs="-L$withval/lib -lmpeg3"
            AC_DEFINE(HAVE_MPEG3, 1, libmpeg3 thumbnailer)
            mpeg3="mpeg3 "],
           [AC_SEARCH_LIBS(mpeg3_read_frame, "mpeg3 -lm -lpthread",[
            mpeg3="mpeg3 "
            mpeg3_cflags="-I/usr/include/libmpeg3"
            mpeg3_libs="-lmpeg3"
            AC_DEFINE(HAVE_MPEG3, 1, libmpeg3 thumbnailer)],[
              mpeg3=""
              AC_MSG_WARN([Could not find all headers and libraries for MPEG3 video support: there will be no MPEG3 thumbnails.])],
           [-lm -lpthread])])
else
        AC_MSG_RESULT(yes)
        mpeg3=""
fi
AC_SUBST(mpeg3_libs)
AC_SUBST(mpeg3_cflags)

if test "X$mpeg3" != "X"; then
  CFLAGS="$mpeg3_cflags $CFLAGS"
  LIBS="$mpeg3_libs $LIBS"
  AC_CHECK_LIB(mpeg3, mpeg3_seek_percentage,
    [AC_DEFINE(HAVE_MPEG3_SEEK_PERCENTAGE, 1, old libmpeg3)])
fi

LIBS="$save_LIBS"
CFLAGS="$save_CFLAGS"



dnl ###################
dnl # checking for freetype2 (provider)
dnl ###################

ttf=no;
AC_MSG_CHECKING(whether the truetype font (ttf) plugin is explicitly disabled)
AC_ARG_ENABLE(plugin-ttf, AC_HELP_STRING([--enable-plugin-ttf],[build the file info plugin for true-type font files]),
        [ ac_use_plugin_ttf="$enableval" ],
        [ ac_use_plugin_ttf="yes" ]
        )
if test X"$ac_use_plugin_ttf" = Xyes; then
        AC_MSG_RESULT(no)
     AC_PATH_GENERIC(freetype, 9.0.0, [
                  ttf_cflags=`freetype-config --cflags`
                  ttf_libs=`freetype-config --libs`
                  AC_DEFINE(HAVE_FT2, 1, have freetype2)
                  ttf=yes;
                ],[
                  ttf=no
                  AC_MSG_WARN([Could not find all headers and libraries for freetype2: there will be no extra true-type info in tooltips.])])
else
        AC_MSG_RESULT(yes)
     ttf=no
fi
AC_SUBST(ttf_libs)
AC_SUBST(ttf_cflags)



LIBS="$save_LIBS"






dnl ###########################################################################
dnl # debugging
dnl ###################

AC_MSG_CHECKING(whether debugging is to be enabled)
AC_ARG_ENABLE(debug, AC_HELP_STRING([--enable-debug],[enable debugging]),
        [ ac_use_debug="$enableval" ],
        [ ac_use_debug="yes" ]
        )
if test X"$ac_use_debug" = Xyes; then
        AC_MSG_RESULT(yes)
        AC_DEFINE(NOIR_DEBUG, 1, Enable debugging)

        changequote(,)dnl
        if test "x$GCC" = "xyes"; then
          case " $CFLAGS " in
            *[\ \	]-g[\ \	]*) CFLAGS=`echo "$CFLAGS"|sed -e "s/[ \t]*-g[ \t]*/ /"`; CFLAGS="$CFLAGS -g3";;
#           *[\ \	]-g[\ \	]*) CFLAGS="${CFLAGS/[\ \	]-g[\ \	]/}"; CFLAGS="$CFLAGS -g3";;
            *[\ \	]-g[0-9][\ \	]*) ;;
            *) CFLAGS="$CFLAGS -g3" ;;
          esac
        else
          case " $CFLAGS " in
            *[\ \	]-g[\ \	]*)         echo "-g already present; using that (use CFLAGS to override)";;
            *[\ \	]-g[0-9][\ \	]*) echo "-g<n> already present; using that (use CFLAGS to override)";;
            *[\ \	]-O[\ \	]*)         echo "won't force -g together with -O on unknown compiler, resorting to plain -g (use CFLAGS to override)";    CFLAGS="-G";;
            *[\ \	]-O[0-9][\ \	]*) echo "won't force -g together with -O<n> on unknown compiler, resorting to plain -g (use CFLAGS to override)"; CFLAGS="-G";;
            *) CFLAGS="$CFLAGS -g" ;;
          esac
        fi
        changequote([,])dnl
        AC_MSG_NOTICE([debug-info enabled; CFLAGS="$CFLAGS"...])
        debug=yes;
else
        AC_MSG_RESULT(no)
        debug=no;
fi






dnl ###########################################################################
dnl ###########################################################################
dnl ###########################################################################






dnl prefix
if test "x${prefix}" = "xNONE"; then
  AC_DEFINE_UNQUOTED(PACKAGE_PREFIX,
  "${ac_default_prefix}", Prefix)
else
  AC_DEFINE_UNQUOTED(PACKAGE_PREFIX, "${prefix}", Prefix)
fi

dnl Set PACKAGE_LOCALE_DIR in config.h.
if test "x${prefix}" = "xNONE"; then
  AC_DEFINE_UNQUOTED(PACKAGE_LOCALE_DIR,
  "${ac_default_prefix}/${DATADIRNAME}/locale", locale)
else
  AC_DEFINE_UNQUOTED(PACKAGE_LOCALE_DIR, "${prefix}/${DATADIRNAME}/locale", locale)
fi

dnl Set PACKAGE_DATA_DIR in config.h.
if test "x${datadir}" = 'x${prefix}/share'; then
  if test "x${prefix}" = "xNONE"; then
    AC_DEFINE_UNQUOTED(PACKAGE_DATA_DIR,
    "${ac_default_prefix}/share/${PACKAGE}", "")
  else
    AC_DEFINE_UNQUOTED(PACKAGE_DATA_DIR, "${prefix}/share/${PACKAGE}", data)
  fi
else
  AC_DEFINE_UNQUOTED(PACKAGE_DATA_DIR, "${datadir}/${PACKAGE}", data)
fi

dnl Set PACKAGE_SOURCE_DIR in config.h.
packagesrcdir=`cd $srcdir && pwd`
AC_DEFINE_UNQUOTED(PACKAGE_SOURCE_DIR, "${packagesrcdir}", src)

dnl Use -Wall if we have gcc.
changequote(,)dnl
if test "x$GCC" = "xyes"; then
  case " $CFLAGS " in
  *[\ \	]-Wall[\ \	]*) ;;
  *) CFLAGS="$CFLAGS -Wall" ;;
  esac
fi
changequote([,])dnl



dnl pthread.
AC_SUBST(PTHREAD_LIBS)
AC_SUBST(PTHREAD_CFLAGS)
AC_SUBST(PTHREAD_CC)



dnl
dnl Adjust the Makefile.am conditionals accordingly
dnl

AM_CONDITIONAL(BUILD_ECORE_MAINLOOP,       test "$loop" = "eCore")
AM_CONDITIONAL(BUILD_ECORE_DEPENDENT,      test "$ecore" != "no")



dnl canvas
AM_CONDITIONAL(BUILD_WITH_GNOMECANVAS,     test "$gnomecanvas" = "yes")
AM_CONDITIONAL(BUILD_WITH_EVAS2,           test "$evas" = "yes")
AM_CONDITIONAL(BUILD_WITH_ICONLIST,        test "$evas" = "yes" -o "$gnomecanvas" = "yes")

AM_CONDITIONAL(BUILD_WITH_EDB,             test "$edb" = "yes")
AM_CONDITIONAL(BUILD_WITH_EET,             test "$eet" = "yes")
AM_CONDITIONAL(BUILD_WITH_EDJE,            test "$edje" = "yes")
AM_CONDITIONAL(BUILD_WITH_X,               test "$xwindow" = "yes")



dnl providers
AM_CONDITIONAL(BUILD_PLUGIN_IMAGE,         test "$imlib2" != "")
AM_CONDITIONAL(BUILD_PLUGIN_TAGLIB,        test "$taglib" = "yes")
AM_CONDITIONAL(BUILD_PLUGIN_LIBVORBIS,     test "$vorbisfile" = "yes")
AM_CONDITIONAL(BUILD_PLUGIN_MP3,           test "$id3" = "yes")
AM_CONDITIONAL(BUILD_PLUGIN_TTF,           test "$ttf" = "yes")
AM_CONDITIONAL(BUILD_PLUGIN_EXTRACTOR,     test "$extractor" = "yes")

dnl backends
AM_CONDITIONAL(BUILD_BACKEND_POSIX,        test "$posix" = "yes")
AM_CONDITIONAL(BUILD_BACKEND_GNOMEVFS2,    test "$gnomevfs2" = "yes")
AM_CONDITIONAL(BUILD_BACKEND_KIO,          test "$kio" = "yes")
AM_CONDITIONAL(BUILD_BACKEND_EFSD,         test "$efsd" = "yes")

dnl thumbnailers
if test "x$imlib2" = "x"; then
  epeg=""
fi
AM_CONDITIONAL(BUILD_THUMBNAILER_IMLIB2,   test "$imlib2" != "")
AM_CONDITIONAL(BUILD_THUMBNAILER_EPEG,     test "$epeg" != "")
AM_CONDITIONAL(BUILD_THUMBNAILER_AVIFILE,  test "$avi" != "")
AM_CONDITIONAL(BUILD_THUMBNAILER_MPEG3,    test "$mpeg3" != "")
AM_CONDITIONAL(BUILD_THUMBNAILER_XINE,     test "$xine" != "")
AM_CONDITIONAL(BUILD_THUMBNAILER_ID3,      test "$id3" = "yes")

dnl IPC
AM_CONDITIONAL(BUILD_IPC_ECORE,            test "$ecoreipc" != "")
AM_CONDITIONAL(BUILD_IPC_DCOP,             test "$dcop" != "")
AM_CONDITIONAL(BUILD_IPC_DCOPC,            test "$dcopc" != "")
AM_CONDITIONAL(BUILD_IPC_DBUS,             test "$dbus" != "")

dnl artwork (themes/iconsets)
AM_CONDITIONAL(INSTALL_ALL_THEMES,         test "$all_themes" = "yes")
AM_CONDITIONAL(INSTALL_ALL_ICONSETS,       test "$all_iconsets" = "yes")



AC_OUTPUT([
Makefile
evidence.lsm
evidence.spec
src/Makefile
src/thumbnailer/Makefile
src/thumbnailer/epeg/Makefile
src/thumbnailer/imlib_loaders/Makefile
src/thumbnailer/ttf/Makefile
src/thumbnailer/id3/Makefile
src/thumbnailer/avifile/Makefile
src/thumbnailer/mpeg3/Makefile
src/thumbnailer/xine/Makefile
src/ipc/Makefile
src/providers/Makefile
src/providers/backends/Makefile
src/providers/taglib/Makefile
src/providers/vorbis/Makefile
src/providers/mp3/Makefile
src/providers/ape/Makefile
src/providers/folder/Makefile
src/providers/exif/Makefile
src/providers/image/Makefile
src/providers/ttf/Makefile
src/providers/extractor/Makefile
src/actions/Makefile
src/actions/null/Makefile
src/actions/thumbnail/Makefile
src/actions/playlist/Makefile
src/actions/name2tag/Makefile
src/actions/tag2name/Makefile
src/actions/sortkey2name/Makefile
