src/gui/common/Makefile
evidence.themes/Makefile
icons/Makefile
])
# evidence.themes/engines/Makefile



if test "X$loop" = "X"; then
  AC_ERROR([Cannot compile with no main-loop, please select one!]);
fi

providers=""
if test "$taglib"     = "yes"; then providers="$providers TagLib";        fi
if test "$vorbisfile" = "yes"; then providers="$providers OggVorbis";     fi
if test "$id3"        = "yes"; then providers="$providers MP3/ID3";       fi
if test "$ttf"        = "yes"; then providers="$providers TrueTypeFonts"; fi
if test "$imlib2"    != "";    then providers="$providers pictures";      fi
if test "$extractor"  = "yes"; then providers="$providers misc";          fi

if test "$gnomecanvas" = "yes"; then
  canvas="GNOME-canvas";
else
  if test "$evas" = "yes"; then
    canvas="evas"
    evas_xtra=" X11";
    if test "$evas_gl" = "yes"; then
      evas_xtra="$evas_xtra GL";
    fi
    if test "$eet" = "yes"; then
      evas_xtra="$evas_xtra EET";
    fi
    if test "$edb" = "yes"; then
      evas_xtra="$evas_xtra EDB";
    fi
    if test "$edje" = "yes"; then
      evas_xtra="$evas_xtra edje";
    fi
#    if test "x$evas_xtra" != "x"; then
    canvas="$canvas {$evas_xtra }";
#    fi
  fi
fi


if test "x$id3" = "xyes"; then
  id3="ID3 "
else
  id3=""
fi

if test "x$ttf" = "xyes"; then
  ttf="TTF "
else
  ttf=""
fi



echo -e "\nBuild summary:"
echo    "------------------------"

AC_MSG_RESULT([
Install in:                   $prefix

Views:
  Icon-view:                  $iconview
  Browser:                    $browserview
  Tree-view:                  $treeview

Canvas:                       $canvas

File-system backends:
  POSIX:                      $posix
                              - $libattr
                              - $libacl
                              - $libmagic
                              - $libsharedmime
                              - $threading
                              - $curl
                              - $fam
                              - $fnotify

File-info plugins:           $providers

IPC plugins:                  $dbus$dcop$dcopc$ecoreipc


Optional libs:
  PCRE       (regex):         $pcre
  doodle     (searches)       $doodle
  btrace     (debugging):     $btrace
  Thumbnails (reading):       $imlib2$epeg$id3$ttf$mpeg3$avi$xine
  Thumbnails (writing):       $libpng$epeg
  XWindow    (direct use):    $xwindow

Miscellaneous:
  extra themes:               $all_themes
  extra icon-sets:            $all_iconsets
  hashes from:                $hashes
  main-loop:                  $loop
  XDS:                        $xds
  debug-info:                 $debug (CFLAGS="$CFLAGS")
  ])



# Taglib  (Ogg, MP3, ...): $taglib
# Vorbis  (Ogg):           $vorbisfile
# ID3     (MP3):           $id3
# Fonts   (TTF):           $ttf
# Images:                  $imlib2
# Misc:                    $extractor

#  GnomeVFS:                $gnomevfs
#  KIO:                     $kio
#  Efsd:                    $efsd
